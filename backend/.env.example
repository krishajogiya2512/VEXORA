# ============================================================
# VEXORA Backend – Environment Configuration Example
# ============================================================
# Copy this file to .env and fill in your real values.
# NEVER commit .env to Git.
# ============================================================

# ── Server ───────────────────────────────────────────────────
PORT=5001
NODE_ENV=development

# ── MongoDB Atlas ─────────────────────────────────────────────
# Replace with your actual Atlas connection string.
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=your_mongodb_atlas_connection_string_here

# ── Authentication ────────────────────────────────────────────
# Use a long random string in production (e.g. openssl rand -hex 64)
JWT_SECRET=change_this_to_a_long_random_secret_in_production
JWT_EXPIRES_IN=1d

# ── CORS ─────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CLIENT_URL=http://localhost:5173

# ── File Uploads ──────────────────────────────────────────────
# Max file size in bytes (default: 5 MB)
UPLOAD_MAX_SIZE=5242880

# ── ML Service (optional) ─────────────────────────────────────
# Leave blank if you do not have an ML backend running
ML_SERVICE_URL=
